# Documentation template only; no automatic dotenv loading.
# Export values in a private shell/environment for intentionally online runs.
AGENTM_LLM_PROFILE=qwen_flash
AGENTM_LLM_PROVIDER=qwen
AGENTM_LLM_MODEL=qwen3.6-flash
AGENTM_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENTM_LLM_API_KEY=
DASHSCOPE_API_KEY=
AGENTM_ES_URL=http://127.0.0.1:9200
# Optional override of reaction data root (absolute path recommended).
# AGENTM_REACTION_DATA_ROOT=/your/resource/location/reaction_sources
